{
  "name": "ts-script-template",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "depcruise": "depcruise src/",
    "lint:md": "markdownlint-cli2",
    "lint:actions": "actionlint",
    "lint:sh": "git ls-files --cached --others --exclude-standard '*.sh' | xargs shellcheck",
    "format:sh": "git ls-files --cached --others --exclude-standard '*.sh' | xargs shfmt -i 2 -ci -bn -sr -d",
    "format:sh:fix": "git ls-files --cached --others --exclude-standard '*.sh' | xargs shfmt -i 2 -ci -bn -sr -w",
    "scan:secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "scan:gitleaks": "gitleaks git --redact --no-banner",
    "dev": "tsx src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "imports": {
    "#@/*": "./src/*"
  },
  "knip": {
    "ignoreBinaries": [
      "actionlint",
      "gitleaks",
      "shellcheck",
      "shfmt"
    ],
    "ignoreDependencies": [
      "@commitlint/cli",
      "lefthook",
      "@secretlint/secretlint-rule-preset-recommend"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.4.0",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-perfectionist": "^5.7.0",
    "jiti": "^2.6.1",
    "knip": "^6.1.1",
    "lefthook": "^2.1.5",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.1",
    "secretlint": "^13.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.3"
  }
}
